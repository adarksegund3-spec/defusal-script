local HL_TAG = "AKZ_HL"
local SKELETON_R15 = {
    {"Head","UpperTorso"}, {"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"}, {"LeftUpperArm","LeftLowerArm"}, {"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"}, {"RightUpperArm","RightLowerArm"}, {"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"}, {"LeftUpperLeg","LeftLowerLeg"}, {"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"}, {"RightUpperLeg","RightLowerLeg"}, {"RightLowerLeg","RightFoot"},
}
local SKELETON_R6 = {
    {"Head","Torso"}, {"Torso","Left Arm"}, {"Torso","Right Arm"},
    {"Torso","Left Leg"}, {"Torso","Right Leg"},
}
local function getSkeletonPairs(char)
    if char:FindFirstChild("UpperTorso") then return SKELETON_R15 end
    return SKELETON_R6
end

local function removeDrawing(d)
    if d == nil then return end
    if type(d) == "table" and not d.Remove then
        for _, v in pairs(d) do removeDrawing(v) end
    else
        pcall(function() d:Remove() end)
    end
end

local espCache = {}

local function clearESPForPlayer(player)
    local c = espCache[player]
    if not c then return end
    if c.highlight then c.highlight:Destroy(); c.highlight = nil end
    if c.billboard then c.billboard:Destroy(); c.billboard = nil end
    if c.drawings then
        for _, d in pairs(c.drawings) do removeDrawing(d) end
        c.drawings = {}
    end
end

local function clearAllESP()
    for p in pairs(espCache) do clearESPForPlayer(p) end
end

local function get2DBounds(char)
    local cf, size
    local ok = pcall(function() cf, size = char:GetBoundingBox() end)
    if not ok or not cf then return nil end
    size = size + Vector3.new(0, 0.6, 0)
    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local any = false
    for ix = -0.5, 0.5, 1 do
        for iy = -0.5, 0.5, 1 do
            for iz = -0.5, 0.5, 1 do
                local wp = cf:PointToWorldSpace(Vector3.new(ix*size.X, iy*size.Y, iz*size.Z))
                local sp, on = Camera:WorldToViewportPoint(wp)
                if on then
                    any = true
                    minX = math.min(minX, sp.X); minY = math.min(minY, sp.Y)
                    maxX = math.max(maxX, sp.X); maxY = math.max(maxY, sp.Y)
                end
            end
        end
    end
    if not any then return nil end
    return Vector2.new(minX, minY), Vector2.new(maxX, maxY)
end

local function updatePlayerESP(player)
    if player == LocalPlayer then return end

    if Config.ESPTeamCheck and isAlly(player) then
        clearESPForPlayer(player)
        return
    end

    local char = player.Character
    if not char then clearESPForPlayer(player); return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then clearESPForPlayer(player); return end

    local color = getTeamColor(player)
    local cache = espCache[player]
    if not cache then cache = { drawings = {} }; espCache[player] = cache end

    -- Highlight
    local querHighlight = Config.Highlight and (Config.HighlightFill or Config.HighlightOutline)
    if querHighlight then
        if not cache.highlight or not cache.highlight.Parent then
            local hl = Instance.new("Highlight")
            hl.Name = HL_TAG
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = char
            hl.Parent = char
            cache.highlight = hl
        end
        cache.highlight.FillColor = color
        cache.highlight.OutlineColor = color
        cache.highlight.FillTransparency    = Config.HighlightFill    and 0.4 or 1
        cache.highlight.OutlineTransparency = Config.HighlightOutline and 0   or 1
    elseif cache.highlight then
        cache.highlight:Destroy(); cache.highlight = nil
    end

    -- Nome
    local head = char:FindFirstChild("Head")
    if Config.ShowName and head then
        if not cache.billboard or not cache.billboard.Parent then
            local bb = Instance.new("BillboardGui")
            bb.Size = UDim2.new(0, 180, 0, 24)
            bb.StudsOffset = Vector3.new(0, 2.8, 0)
            bb.AlwaysOnTop = true
            bb.ResetOnSpawn = false
            bb.Adornee = head
            bb.Parent = head
            local lbl = Instance.new("TextLabel")
            lbl.Name = "Lbl"
            lbl.Size = UDim2.new(1, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Font = Enum.Font.GothamBold
            lbl.TextSize = 13
            lbl.TextStrokeTransparency = 0
            lbl.TextStrokeColor3 = Color3.new(0,0,0)
            lbl.Parent = bb
            cache.billboard = bb
        end
        cache.billboard.Lbl.Text = player.DisplayName
        cache.billboard.Lbl.TextColor3 = color
    elseif cache.billboard then
        cache.billboard:Destroy(); cache.billboard = nil
    end

    -- Drawing: Box / Skeleton / Tracer
    if hasDrawing then
        local top, bottom = get2DBounds(char)
        if Config.Box and top and bottom then
            if not cache.drawings.box then
                local sq = Drawing.new("Square")
                sq.Thickness = 1; sq.Filled = false; sq.Transparency = 1
                cache.drawings.box = sq
            end
            local b = cache.drawings.box
            b.Position = top
            b.Size = Vector2.new(bottom.X - top.X, bottom.Y - top.Y)
            b.Color = color
            b.Visible = true
        elseif cache.drawings.box then
            cache.drawings.box.Visible = false
        end

        local pairsList = getSkeletonPairs(char)
        cache.drawings.lines = cache.drawings.lines or {}
        if Config.Skeleton then
            for i, p in ipairs(pairsList) do
                if not cache.drawings.lines[i] then
                    local l = Drawing.new("Line")
                    l.Thickness = 1; l.Transparency = 1
                    cache.drawings.lines[i] = l
                end
                local ln = cache.drawings.lines[i]
                local a = char:FindFirstChild(p[1])
                local b = char:FindFirstChild(p[2])
                if a and b then
                    local sa, oa = Camera:WorldToViewportPoint(a.Position)
                    local sb, ob = Camera:WorldToViewportPoint(b.Position)
                    if oa and ob then
                        ln.From = Vector2.new(sa.X, sa.Y)
                        ln.To = Vector2.new(sb.X, sb.Y)
                        ln.Color = color
                        ln.Visible = true
                    else ln.Visible = false end
                else ln.Visible = false end
            end
            for i = #pairsList + 1, #cache.drawings.lines do
                cache.drawings.lines[i].Visible = false
            end
        else
            for _, l in ipairs(cache.drawings.lines) do l.Visible = false end
        end

        if Config.ShowTracer and top and bottom then
            if not cache.drawings.tracer then
                local t = Drawing.new("Line")
                t.Thickness = 1; t.Transparency = 1
                cache.drawings.tracer = t
            end
            local t = cache.drawings.tracer
            t.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            t.To = Vector2.new((top.X + bottom.X) / 2, bottom.Y)
            t.Color = color
            t.Visible = true
        elseif cache.drawings.tracer then
            cache.drawings.tracer.Visible = false
        end
    end
end


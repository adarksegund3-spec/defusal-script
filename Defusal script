-- TEAM CHECK — lê Character:GetAttribute("TeamColor")
-- ═══════════════════════════════════════════════════════════════
local function getTeamString(player)
    if not player then return nil end
    local char = player.Character
    if not char then return nil end
    local ok, val = pcall(function() return char:GetAttribute("TeamColor") end)
    if ok and val then return tostring(val) end
    return nil
end

local function parseRGB(s)
    if not s then return nil end
    local r, g, b = s:match("([%d%.]+),%s*([%d%.]+),%s*([%d%.]+)")
    if r and g and b then
        return Color3.new(tonumber(r) or 1, tonumber(g) or 1, tonumber(b) or 1)
    end
    return nil
end

local function isAlly(player)
    if not player or player == LocalPlayer then return false end
    local myTeam = getTeamString(LocalPlayer)
    local theirTeam = getTeamString(player)
    if not myTeam or not theirTeam then return false end
    return myTeam == theirTeam
end

local function getTeamColor(player)
    if player == LocalPlayer then return Color3.fromRGB(120, 220, 140) end
    if isAlly(player) then return Color3.fromRGB(80, 170, 255) end
    local s = getTeamString(player)
    local cor = parseRGB(s)
    if cor then return cor end
    return Color3.fromRGB(220, 40, 40)
end

